---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book a Consultation | Shunya Studio" description="Submit your project brief and schedule a consultation with Rakuma.">
  <div class="booking-page">
    <div class="container">
      <header class="page-header">
        <h1 class="text-display">Start a Project</h1>
        <p class="text-secondary text-body">Provide your project details below to request a consultation.</p>
      </header>

      <div class="booking-form-wrapper">
        <form class="booking-form" id="bookingForm">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="company">Company / Studio</label>
              <input type="text" id="company" name="company" />
            </div>
            <div class="form-group">
              <label for="timezone">Timezone <span class="required">*</span></label>
              <select id="timezone" name="timezone" required>
                <option value="" disabled selected>Select your timezone</option>
                <option value="PST">Pacific Time (PT)</option>
                <option value="EST">Eastern Time (ET)</option>
                <option value="GMT">Greenwich Mean Time (GMT)</option>
                <option value="CET">Central European Time (CET)</option>
                <option value="IST">Indian Standard Time (IST)</option>
                <option value="JST">Japan Standard Time (JST)</option>
                <option value="AEST">Australian Eastern Time (AEST)</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="service">Service Required <span class="required">*</span></label>
              <select id="service" name="service" required>
                <option value="" disabled selected>Select a service</option>
                <option value="concept">Environment Concept Design</option>
                <option value="hardsurface">Hard Surface Modeling</option>
                <option value="environment">Real-time Environment Art</option>
                <option value="other">Other / Custom</option>
              </select>
            </div>
            <div class="form-group">
              <label for="budget">Budget Range <span class="required">*</span></label>
              <select id="budget" name="budget" required>
                <option value="" disabled selected>Select budget range</option>
                <option value="<1k">Under $1,000</option>
                <option value="1k-5k">$1,000 - $5,000</option>
                <option value="5k-15k">$5,000 - $15,000</option>
                <option value="15k+">$15,000+</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="timeline">Preferred Timeline</label>
            <input type="text" id="timeline" name="timeline" placeholder="e.g. Next month, Q3 2024" />
          </div>

          <div class="form-group">
            <label for="brief">Project Brief <span class="required">*</span></label>
            <textarea id="brief" name="brief" rows="6" required placeholder="Describe your project, technical constraints, and visual goals."></textarea>
          </div>

          <div class="form-group">
            <label for="references">Reference Links (ArtStation, Pinterest, Google Drive)</label>
            <textarea id="references" name="references" rows="3" placeholder="Paste links here..."></textarea>
          </div>

          <div class="checkbox-group">
            <input type="checkbox" id="consent" name="consent" required />
            <label for="consent">I consent to the processing of my data for communication regarding this inquiry.</label>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">Submit Request</button>
          
          <div id="formMessage" class="form-message hidden">
            Thank you! Your request has been sent. We will review and reach out shortly to schedule a call.
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .booking-page {
    padding-top: calc(var(--spacing-12) + var(--spacing-6));
    padding-bottom: var(--spacing-12);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }
  
  .page-header h1 {
    font-size: 3.5rem;
    margin-bottom: var(--spacing-2);
  }

  .booking-form-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: var(--surface-color);
    padding: var(--spacing-8);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .form-row {
    display: flex;
    gap: var(--spacing-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    flex-grow: 1;
    width: 100%;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: var(--accent-color);
  }

  input, select, textarea {
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: var(--spacing-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--accent-color);
  }
  
  textarea {
    resize: vertical;
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    margin-top: var(--spacing-2);
  }
  
  .checkbox-group input {
    margin-top: 4px;
    accent-color: var(--accent-color);
  }
  
  .checkbox-group label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .submit-btn {
    margin-top: var(--spacing-4);
    width: 100%;
    padding: var(--spacing-3);
    font-size: 1.1rem;
    border: none;
  }
  
  .btn {
    background-color: var(--accent-color);
    color: var(--bg-color);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .btn:hover {
    background-color: var(--text-primary);
  }
  
  .form-message {
    margin-top: var(--spacing-4);
    padding: var(--spacing-3);
    border-radius: var(--radius-sm);
    background: rgba(76, 175, 80, 0.1);
    color: var(--success);
    border: 1px solid var(--success);
    text-align: center;
  }
  
  .hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .form-row {
      flex-direction: column;
    }
    
    .booking-form-wrapper {
      padding: var(--spacing-4);
    }
  }
</style>

<script>
  const bookingForm = document.getElementById('bookingForm');
  const btnText = document.getElementById('btnText');
  const btnLoader = document.getElementById('btnLoader');
  const successMessage = document.getElementById('successMessage');
  const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';

  if (bookingForm) {
    bookingForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(bookingForm as HTMLFormElement);
      const data = Object.fromEntries(formData);
      
      // Loading state
      btnText?.classList.add('hidden');
      btnLoader?.classList.remove('hidden');
      
      try {
        const response = await fetch(`${apiUrl}/bookings`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (!response.ok) throw new Error('Submission failed');
        
        // Success
        bookingForm.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      } catch (error) {
        alert("Failed to submit request. Please try again.");
      } finally {
        // Reset loader
        btnText?.classList.remove('hidden');
        btnLoader?.classList.add('hidden');
      }
    });
  }
</script>
