---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Environment Concept Design',
    description: 'High-end 2D and 3D concept art for game environments and cinematic worlds.',
    features: ['Moodboards & Lookdev', 'Blockouts', 'Final Painted Concept', 'Lighting Setup']
  },
  {
    title: 'Hard Surface Modeling',
    description: 'Detailed, highly optimized hard surface assets for props, weapons, and vehicles.',
    features: ['High/Low Poly Modeling', 'UV Unwrapping', 'PBR Texturing', 'LOD Generation']
  },
  {
    title: 'Real-time Environment Art',
    description: 'Game-ready environments built for Unreal Engine 5 with Nanite and Lumen in mind.',
    features: ['Modular Kits', 'Trim Sheets', 'Material Blending', 'Lighting & Optimization']
  }
];

const faqs = [
  { q: 'What is your typical turnaround time?', a: 'Depending on the complexity, a single hero asset takes 1-2 weeks, while a full environment can take 4-8 weeks.' },
  { q: 'Do you provide source files?', a: 'Yes, source files (.blend, .spp, .psd) are available upon request, subject to licensing terms.' },
  { q: 'What software do you use?', a: 'Blender, ZBrush, Substance Painter, Substance Designer, and Unreal Engine 5.' }
];
---

<Layout title="Services | Shunya Studio" description="Premium 3D art services including environment design and hard surface modeling.">
  <div class="services-page">
    <div class="container">
      <header class="page-header">
        <h1 class="text-display">Capabilities</h1>
        <p class="text-secondary text-body">From initial concept to game-ready integration, we deliver premium 3D art for ambitious projects.</p>
      </header>

      <div class="services-grid">
        {services.map((service, i) => (
          <div class="service-card">
            <div class="service-icon text-display">0{i + 1}</div>
            <h2 class="text-display">{service.title}</h2>
            <p class="text-secondary">{service.description}</p>
            <ul class="feature-list">
              {service.features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <section class="process-section">
        <h2 class="text-display section-title">Our Process</h2>
        <div class="process-steps">
          <div class="step">
            <span class="step-num text-display">1</span>
            <h3>Discovery</h3>
            <p class="text-secondary">Aligning on art direction, references, and technical constraints.</p>
          </div>
          <div class="step">
            <span class="step-num text-display">2</span>
            <h3>Blockout</h3>
            <p class="text-secondary">Establishing scale, composition, and gameplay readability.</p>
          </div>
          <div class="step">
            <span class="step-num text-display">3</span>
            <h3>Production</h3>
            <p class="text-secondary">High-fidelity modeling, texturing, and initial lighting passes.</p>
          </div>
          <div class="step">
            <span class="step-num text-display">4</span>
            <h3>Delivery</h3>
            <p class="text-secondary">Final Polish, LODs, and integration into the target engine.</p>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <h2 class="text-display section-title">Frequently Asked Questions</h2>
        <div class="faq-grid">
          {faqs.map(faq => (
            <div class="faq-item">
              <h4>{faq.q}</h4>
              <p class="text-secondary">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cta-section">
        <h2 class="text-display">Ready to discuss your project?</h2>
        <a href="/pricing" class="btn btn-primary">View Pricing</a>
        <a href="/booking" class="btn btn-outline">Book a Call</a>
      </section>
    </div>
  </div>
</Layout>

<style>
  .services-page {
    padding-top: calc(var(--spacing-12) + var(--spacing-6));
    padding-bottom: var(--spacing-12);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }
  
  .page-header h1 {
    font-size: 4rem;
    margin-bottom: var(--spacing-2);
  }
  
  .page-header p {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-12);
  }

  .service-card {
    background: var(--surface-color);
    padding: var(--spacing-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
  }

  .service-icon {
    font-size: 3rem;
    color: var(--accent-muted);
    margin-bottom: var(--spacing-4);
  }

  .service-card h2 {
    font-size: 1.75rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-4);
    border-top: 1px solid var(--border-color);
    padding-top: var(--spacing-4);
  }

  .feature-list li {
    margin-bottom: var(--spacing-2);
    padding-left: var(--spacing-4);
    position: relative;
    color: var(--text-secondary);
  }

  .feature-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent-color);
  }

  .section-title {
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .process-section {
    margin-bottom: var(--spacing-12);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-6);
  }

  .step {
    text-align: center;
  }

  .step-num {
    display: block;
    font-size: 4rem;
    color: var(--accent-muted);
    margin-bottom: var(--spacing-2);
  }

  .faq-section {
    margin-bottom: var(--spacing-12);
    background: var(--surface-color);
    padding: var(--spacing-8);
    border-radius: var(--radius-md);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-6);
  }

  .faq-item h4 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-2);
  }

  .cta-section {
    text-align: center;
    padding: var(--spacing-8) 0;
  }

  .cta-section .btn {
    margin: var(--spacing-4) var(--spacing-2) 0 var(--spacing-2);
  }
  
  .btn {
    display: inline-block;
    padding: var(--spacing-2) var(--spacing-4);
    font-size: 1.1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }
  
  .btn-primary {
    background-color: var(--accent-color);
    color: var(--bg-color);
    border: 1px solid var(--accent-color);
  }
  
  .btn-outline {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
</style>

<script>
  import gsap from 'gsap';
  
  gsap.from('.page-header > *', {
    y: 30,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: 'power3.out'
  });
  
  gsap.from('.service-card', {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: 'power3.out',
    delay: 0.2
  });
</script>
