---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    title: 'Optimizing Nanite for Foliage in UE5',
    excerpt: 'A deep dive into managing overdraw and shadow maps when using dense Nanite foliage in open worlds.',
    category: 'Technical Art',
    date: 'Oct 10, 2024',
    readTime: '8 min read',
    slug: 'optimizing-nanite-foliage'
  },
  {
    title: 'The Psychology of Lighting in Horror Games',
    excerpt: 'How to use contrast, color temperature, and volumetric fog to guide the player and build tension.',
    category: 'Art Direction',
    date: 'Sep 28, 2024',
    readTime: '6 min read',
    slug: 'psychology-lighting-horror'
  },
  {
    title: 'My Hard Surface Workflow for 2024',
    excerpt: 'Breaking down my updated pipeline using ZBrush, Moi3D, and Blender for rapid concepting.',
    category: 'Tutorial',
    date: 'Sep 15, 2024',
    readTime: '12 min read',
    slug: 'hardsurface-workflow-2024'
  }
];
---

<Layout title="Insights & Articles | Shunya Studio" description="Read technical breakdowns, tutorials, and art direction insights from Rakuma.">
  <div class="blog-page">
    <div class="container">
      <header class="page-header">
        <h1 class="text-display">Insights</h1>
        <p class="text-secondary text-body">Technical breakdowns, industry thoughts, and workflow tutorials.</p>
      </header>

      <div class="blog-grid">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="blog-card">
            <div class="blog-image">
              <div class="image-placeholder"></div>
            </div>
            <div class="blog-content">
              <div class="blog-meta">
                <span class="category">{post.category}</span>
                <span class="dot">&bull;</span>
                <span class="time">{post.readTime}</span>
              </div>
              <h2 class="text-display">{post.title}</h2>
              <p class="text-secondary">{post.excerpt}</p>
              <span class="date">{post.date}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    padding-top: calc(var(--spacing-12) + var(--spacing-6));
    padding-bottom: var(--spacing-12);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-12);
  }
  
  .page-header h1 {
    font-size: 4rem;
    margin-bottom: var(--spacing-2);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--spacing-6);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
  }

  .blog-image {
    height: 250px;
    overflow: hidden;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, var(--surface-elevated), var(--surface-color));
    transition: transform 0.5s ease;
  }

  .blog-card:hover .image-placeholder {
    transform: scale(1.05);
  }

  .blog-content {
    padding: var(--spacing-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-3);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .category {
    color: var(--accent-color);
  }

  .time, .dot {
    color: var(--text-secondary);
  }

  .blog-content h2 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-2);
  }

  .blog-content p {
    margin-bottom: var(--spacing-4);
    flex-grow: 1;
  }

  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: var(--spacing-3);
    margin-top: auto;
  }
</style>

<script>
  import gsap from 'gsap';
  
  gsap.from('.blog-card', {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: 'power3.out'
  });
</script>
