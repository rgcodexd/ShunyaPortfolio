---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo.png';
import logoText from '../../assets/logo_text.png';

// Dashboard application shell.
---

<Layout title="Dashboard Login | Shunya Studio" description="Admin dashboard login.">
  <div class="dashboard-shell">
    <div class="login-container" id="loginView">
      <div style="text-align: center; margin-bottom: 24px;">
        <img src={logo.src} alt="Shunya Studio" style="width: 80px; height: auto;" />
      </div>
      <h1 class="text-display">Studio Auth</h1>
      <p class="text-secondary text-body" style="margin-bottom: 24px; text-align: center;">Owner Access Only</p>
      
      <form class="auth-form" id="authForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" required />
        </div>
        <button type="submit" class="btn btn-primary w-full" id="signInBtn">Sign In</button>
      </form>
    </div>

    <!-- The actual dashboard that is shown after login -->
    <div class="dashboard-layout hidden" id="dashboardView">
      <aside class="sidebar">
        <div class="brand" style="margin-bottom: var(--spacing-8); display: flex; align-items: center; justify-content: center;">
          <img src={logoText.src} alt="Shunya Studio" style="height: 32px; width: auto;" />
        </div>
        <nav class="sidebar-nav" id="sidebarNav">
          <button class="nav-tab active" data-target="view-overview">Overview</button>
          <button class="nav-tab" data-target="view-projects">Projects</button>
          <button class="nav-tab" data-target="view-blog">Blog Posts</button>
          <button class="nav-tab" data-target="view-bookings">Bookings</button>
          <button class="nav-tab" data-target="view-comments">Comments</button>
          <button class="nav-tab" data-target="view-media">Media Library</button>
          <button class="nav-tab" data-target="view-settings">Settings</button>
        </nav>
        <button class="btn btn-outline w-full" id="signOutBtn" style="margin-top: auto;">Sign Out</button>
      </aside>
      
      <main class="dashboard-main">
        <header class="dashboard-header">
          <h2 class="text-display" id="dashboardTitle">Overview</h2>
          <div class="user-profile" id="userEmailBadge">Loading...</div>
        </header>
        
        <div class="dashboard-content">
          
          <!-- Overview Tab -->
          <div id="view-overview" class="tab-content active">
            <div class="stats-grid">
              <div class="stat-card">
                <h3>Active Projects</h3>
                <p class="text-display stat-number">12</p>
              </div>
              <div class="stat-card">
                <h3>New Bookings</h3>
                <p class="text-display stat-number">3</p>
              </div>
              <div class="stat-card">
                <h3>Total Views</h3>
                <p class="text-display stat-number">45.2k</p>
              </div>
            </div>
            
            <div class="recent-activity">
              <h3 class="text-display" style="margin-bottom: 16px;">Recent Activity</h3>
              <div class="activity-list">
                <div class="activity-item">New booking request from "Epic Games"</div>
                <div class="activity-item">Comment on "Optimizing Nanite for Foliage"</div>
                <div class="activity-item">Project "Cyberpunk Alley" reached 1,000 views</div>
              </div>
            </div>
          </div>

          <!-- Projects Tab -->
          <div id="view-projects" class="tab-content hidden">
            <h3 class="text-display">Create New Project</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">Add a new portfolio project to your site.</p>
            
            <form id="projectForm" class="dashboard-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="proj_title">Project Title</label>
                  <input type="text" id="proj_title" required />
                </div>
                <div class="form-group">
                  <label for="proj_slug">URL Slug</label>
                  <input type="text" id="proj_slug" placeholder="e.g. cyber-alley" required />
                </div>
              </div>
              <div class="form-group">
                <label for="proj_desc">Description</label>
                <textarea id="proj_desc" rows="3" required></textarea>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="proj_category">Category</label>
                  <input type="text" id="proj_category" placeholder="e.g. 3D Environment" />
                </div>
                <div class="form-group">
                  <label for="proj_client">Client (Optional)</label>
                  <input type="text" id="proj_client" />
                </div>
              </div>
              <div class="form-group">
                <label>Cover Image</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" id="proj_cover" placeholder="Or paste URL here..." style="flex: 1;" />
                  <input type="file" id="proj_cover_file" accept="image/*" style="flex: 1;" />
                </div>
              </div>
              <div class="form-group">
                <label for="proj_embed">3D Embed URL (Optional Sketchfab/Spline)</label>
                <input type="text" id="proj_embed" placeholder="https://..." />
              </div>
              <div class="form-group checkbox-group">
                <input type="checkbox" id="proj_published" checked />
                <label for="proj_published">Publish Immediately</label>
              </div>
              <button type="submit" class="btn btn-primary" id="projSubmitBtn">Save Project</button>
            </form>
          </div>

          <!-- Blog Tab -->
          <div id="view-blog" class="tab-content hidden">
            <h3 class="text-display">Write New Post</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">Draft and publish articles here.</p>
            
            <form id="blogForm" class="dashboard-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="blog_title">Post Title</label>
                  <input type="text" id="blog_title" required />
                </div>
                <div class="form-group">
                  <label for="blog_slug">URL Slug</label>
                  <input type="text" id="blog_slug" placeholder="e.g. nanite-optimization" required />
                </div>
              </div>
              <div class="form-group">
                <label for="blog_excerpt">Short Excerpt</label>
                <textarea id="blog_excerpt" rows="2" required></textarea>
              </div>
              <div class="form-group">
                <label for="blog_content">Full Content (Markdown/HTML)</label>
                <textarea id="blog_content" rows="6" required></textarea>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="blog_category">Category</label>
                  <input type="text" id="blog_category" placeholder="e.g. Tutorial" />
                </div>
                <div class="form-group">
                  <label for="blog_read_time">Read Time</label>
                  <input type="text" id="blog_read_time" placeholder="e.g. 5 min read" />
                </div>
              </div>
              <div class="form-group">
                <label>Cover Image</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" id="blog_cover" placeholder="Or paste URL here..." style="flex: 1;" />
                  <input type="file" id="blog_cover_file" accept="image/*" style="flex: 1;" />
                </div>
              </div>
              <div class="form-group checkbox-group">
                <input type="checkbox" id="blog_published" checked />
                <label for="blog_published">Publish Immediately</label>
              </div>
              <button type="submit" class="btn btn-primary" id="blogSubmitBtn">Publish Post</button>
            </form>
          </div>

          <!-- Bookings Tab -->
          <div id="view-bookings" class="tab-content hidden">
            <h3 class="text-display">Incoming Bookings</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">View all contact and project requests.</p>
            <div id="bookingsList" class="activity-list">
              <!-- Bookings injected here via JS -->
              <div class="activity-item text-secondary text-center">Loading bookings...</div>
            </div>
          </div>

          <!-- Comments Tab -->
          <div id="view-comments" class="tab-content hidden">
            <h3 class="text-display">Comment Moderation</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">Approve or delete user comments.</p>
            <div id="commentsList" class="activity-list">
              <div class="activity-item text-secondary text-center">Loading comments...</div>
            </div>
          </div>

          <!-- Media Tab -->
          <div id="view-media" class="tab-content hidden">
            <h3 class="text-display">Media Library</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">Upload images and digital products securely to your Supabase buckets.</p>
            
            <div class="dashboard-form" style="margin-bottom: 24px;">
              <label>Upload New File to "Uploads" bucket</label>
              <div style="display: flex; gap: 8px;">
                <input type="file" id="mediaUploadInput" style="flex: 1;" />
                <button class="btn btn-primary" id="mediaUploadBtn">Upload</button>
              </div>
            </div>
            
            <div id="mediaGallery" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px;">
              <div class="text-secondary">Loading media...</div>
            </div>
          </div>

          <!-- Settings Tab -->
          <div id="view-settings" class="tab-content hidden">
            <h3 class="text-display">Admin Settings</h3>
            <p class="text-secondary" style="margin-bottom: 24px;">Manage your studio configuration and passwords.</p>
            
            <form id="settingsForm" class="dashboard-form">
              <h4 style="margin-bottom: 12px;">Update Password</h4>
              <div class="form-group">
                <label for="new_password">New Password</label>
                <input type="password" id="new_password" required minlength="8" />
              </div>
              <button type="submit" class="btn btn-primary" id="settingsSubmitBtn">Update Password</button>
            </form>
          </div>

        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  .dashboard-shell {
    min-height: 100vh;
    background: var(--bg-color);
  }
  
  .login-container {
    max-width: 400px;
    margin: 15vh auto;
    padding: var(--spacing-8);
    background: var(--surface-color);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }
  
  .login-container h1 {
    text-align: center;
    margin-bottom: var(--spacing-2);
  }
  
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }
  
  label {
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  input, textarea {
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: var(--spacing-2);
    border-radius: var(--radius-sm);
    font-family: inherit;
  }
  
  .dashboard-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    background: var(--surface-color);
    padding: var(--spacing-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }
  
  .form-row {
    display: flex;
    gap: var(--spacing-4);
  }
  
  .form-row .form-group {
    flex: 1;
  }
  
  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-2);
  }
  
  .checkbox-group input {
    width: auto;
  }
  
  .w-full {
    width: 100%;
  }
  
  .btn {
    padding: var(--spacing-2);
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  
  .btn-primary {
    background: var(--accent-color);
    color: var(--bg-color);
    border: none;
  }
  
  .btn-outline {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }
  
  /* Dashboard Layout */
  .dashboard-layout {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }
  
  .sidebar {
    width: 250px;
    background: var(--surface-color);
    border-right: 1px solid var(--border-color);
    padding: var(--spacing-6);
    display: flex;
    flex-direction: column;
  }
  
  .brand {
    margin-bottom: var(--spacing-8);
    color: var(--accent-color);
  }
  
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  
  .nav-tab {
    color: var(--text-secondary);
    padding: var(--spacing-2);
    border-radius: var(--radius-sm);
    font-weight: 500;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
  }
  
  .nav-tab:hover, .nav-tab.active {
    background: var(--surface-elevated);
    color: var(--text-primary);
  }
  
  .dashboard-main {
    flex-grow: 1;
    overflow-y: auto;
    padding: var(--spacing-8);
  }
  
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-8);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
  }
  
  .user-profile {
    background: var(--surface-color);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: 50px;
    border: 1px solid var(--border-color);
    font-weight: 600;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-8);
  }
  
  .stat-card {
    background: var(--surface-color);
    padding: var(--spacing-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }
  
  .stat-card h3 {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-transform: uppercase;
    margin-bottom: var(--spacing-2);
  }
  
  .stat-number {
    font-size: 3rem;
    color: var(--accent-color);
    margin: 0;
  }
  
  .activity-list {
    background: var(--surface-color);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    overflow: hidden;
  }
  
  .activity-item {
    padding: var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
  }
  
  .activity-item:last-child {
    border-bottom: none;
  }
  
  .hidden {
    display: none !important;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const loginView = document.getElementById('loginView');
  const dashboardView = document.getElementById('dashboardView');
  const authForm = document.getElementById('authForm');
  const signInBtn = document.getElementById('signInBtn');
  const signOutBtn = document.getElementById('signOutBtn');
  const userEmailBadge = document.getElementById('userEmailBadge');
  
  // Tab Elements
  const navTabs = document.querySelectorAll('.nav-tab');
  const tabContents = document.querySelectorAll('.tab-content');
  const dashboardTitle = document.getElementById('dashboardTitle');

  // Check if already logged in on load
  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      showDashboard(session.user);
    }
  }

  function showDashboard(user) {
    if (loginView && dashboardView) {
      loginView.classList.add('hidden');
      dashboardView.classList.remove('hidden');
      
      if (userEmailBadge) {
        userEmailBadge.textContent = user.email;
      }
      
      // Hide global header/footer for dashboard
      const header = document.querySelector('.header');
      const footer = document.querySelector('.footer');
      if (header) header.setAttribute('style', 'display: none;');
      if (footer) footer.setAttribute('style', 'display: none;');
      
      // Load dynamic tab data
      loadBookings();
      loadComments();
      loadMedia();
    }
  }

  function hideDashboard() {
    if (loginView && dashboardView) {
      loginView.classList.remove('hidden');
      dashboardView.classList.add('hidden');
      const header = document.querySelector('.header');
      const footer = document.querySelector('.footer');
      if (header) header.removeAttribute('style');
      if (footer) footer.removeAttribute('style');
    }
  }

  // Handle Login
  if (authForm) {
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      
      if (signInBtn) signInBtn.textContent = "Authenticating...";
      
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        alert("Login failed: " + error.message);
        if (signInBtn) signInBtn.textContent = "Sign In";
      } else {
        if (signInBtn) signInBtn.textContent = "Sign In";
        showDashboard(data.user);
      }
    });
  }
  
  // Handle Sign Out
  if (signOutBtn) {
    signOutBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signOut();
      if (error) {
        alert("Error signing out.");
      } else {
        hideDashboard();
      }
    });
  }

  // Handle Tab Switching
  navTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active class from all tabs
      navTabs.forEach(t => t.classList.remove('active'));
      // Add active class to clicked tab
      tab.classList.add('active');
      
      // Hide all contents
      tabContents.forEach(content => content.classList.add('hidden'));
      
      // Show targeted content
      const targetId = tab.getAttribute('data-target');
      if (targetId) {
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.classList.remove('hidden');
        }
      }
      
      // Update Title
      if (dashboardTitle) {
        dashboardTitle.textContent = tab.textContent;
      }
    });
  });

  // Handle Project Form Submission
  const projectForm = document.getElementById('projectForm');
  if (projectForm) {
    projectForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('projSubmitBtn');
      if (btn) btn.textContent = 'Saving...';
      
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return alert("You must be logged in.");

      let coverImageUrl = (document.getElementById('proj_cover') as HTMLInputElement).value;
      const fileInput = document.getElementById('proj_cover_file') as HTMLInputElement;
      
      if (fileInput.files && fileInput.files.length > 0) {
        if (btn) btn.textContent = 'Uploading Image...';
        const file = fileInput.files[0];
        const fileExt = file.name.split('.').pop();
        const fileName = `${Date.now()}.${fileExt}`;
        
        const { data: uploadData, error: uploadError } = await supabase.storage
          .from('projects')
          .upload(`covers/${fileName}`, file);
          
        if (uploadError) {
          alert("Image upload failed: " + uploadError.message);
          if (btn) btn.textContent = 'Save Project';
          return;
        }
        
        const { data: { publicUrl } } = supabase.storage.from('projects').getPublicUrl(`covers/${fileName}`);
        coverImageUrl = publicUrl;
      }
      
      if (btn) btn.textContent = 'Saving...';

      const payload = {
        title: (document.getElementById('proj_title') as HTMLInputElement).value,
        slug: (document.getElementById('proj_slug') as HTMLInputElement).value,
        description: (document.getElementById('proj_desc') as HTMLTextAreaElement).value,
        category: (document.getElementById('proj_category') as HTMLInputElement).value,
        client: (document.getElementById('proj_client') as HTMLInputElement).value,
        cover_image: coverImageUrl,
        embed_url: (document.getElementById('proj_embed') as HTMLInputElement).value,
        is_published: (document.getElementById('proj_published') as HTMLInputElement).checked
      };

      const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';
      
      try {
        const res = await fetch(`${apiUrl}/admin/projects`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${session.access_token}`
          },
          body: JSON.stringify(payload)
        });
        
        if (!res.ok) throw new Error(await res.text());
        alert("Project saved successfully!");
        (projectForm as HTMLFormElement).reset();
      } catch (err) {
        alert("Failed to save project: " + err);
      } finally {
        if (btn) btn.textContent = 'Save Project';
      }
    });
  }

  // Handle Blog Form Submission
  const blogForm = document.getElementById('blogForm');
  if (blogForm) {
    blogForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('blogSubmitBtn');
      if (btn) btn.textContent = 'Publishing...';
      
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return alert("You must be logged in.");

      let coverImageUrl = (document.getElementById('blog_cover') as HTMLInputElement).value;
      const fileInput = document.getElementById('blog_cover_file') as HTMLInputElement;
      
      if (fileInput.files && fileInput.files.length > 0) {
        if (btn) btn.textContent = 'Uploading Image...';
        const file = fileInput.files[0];
        const fileExt = file.name.split('.').pop();
        const fileName = `${Date.now()}.${fileExt}`;
        
        const { data: uploadData, error: uploadError } = await supabase.storage
          .from('uploads')
          .upload(`blogs/${fileName}`, file);
          
        if (uploadError) {
          alert("Image upload failed: " + uploadError.message);
          if (btn) btn.textContent = 'Publish Post';
          return;
        }
        
        const { data: { publicUrl } } = supabase.storage.from('uploads').getPublicUrl(`blogs/${fileName}`);
        coverImageUrl = publicUrl;
      }

      if (btn) btn.textContent = 'Publishing...';

      const payload = {
        title: (document.getElementById('blog_title') as HTMLInputElement).value,
        slug: (document.getElementById('blog_slug') as HTMLInputElement).value,
        excerpt: (document.getElementById('blog_excerpt') as HTMLTextAreaElement).value,
        content: (document.getElementById('blog_content') as HTMLTextAreaElement).value,
        category: (document.getElementById('blog_category') as HTMLInputElement).value,
        read_time: (document.getElementById('blog_read_time') as HTMLInputElement).value,
        cover_image: coverImageUrl,
        is_published: (document.getElementById('blog_published') as HTMLInputElement).checked
      };

      const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';
      
      try {
        const res = await fetch(`${apiUrl}/admin/blogs`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${session.access_token}`
          },
          body: JSON.stringify(payload)
        });
        
        if (!res.ok) throw new Error(await res.text());
        alert("Blog published successfully!");
        (blogForm as HTMLFormElement).reset();
      } catch (err) {
        alert("Failed to publish blog: " + err);
      } finally {
        if (btn) btn.textContent = 'Publish Post';
      }
    });
  }

  // --- BOOKINGS ---
  async function loadBookings() {
    const list = document.getElementById('bookingsList');
    if (!list) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';

    try {
      const res = await fetch(`${apiUrl}/admin/bookings`, {
        headers: { 'Authorization': `Bearer ${session.access_token}` }
      });
      const bookings = await res.json();
      
      if(bookings.length === 0) {
        list.innerHTML = '<div class="activity-item text-secondary text-center">No bookings found.</div>';
        return;
      }
      
      list.innerHTML = bookings.map((b: any) => `
        <div class="activity-item" style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <strong>${b.name}</strong> (${b.email}) - <span style="opacity: 0.7">${new Date(b.created_at).toLocaleDateString()}</span>
            <p style="margin-top: 8px;">Budget: ${b.budget || 'N/A'}</p>
            <p style="margin-top: 4px;">Brief: ${b.project_brief || 'N/A'}</p>
            <p style="margin-top: 4px;">Status: <strong>${b.status}</strong></p>
          </div>
          ${b.status !== 'Reviewed' ? `<button class="btn btn-outline" style="font-size: 0.8rem; padding: 4px 8px;" onclick="updateBookingStatus('${b.id}', 'Reviewed')">Mark Reviewed</button>` : ''}
        </div>
      `).join('');
    } catch(e) {
      list.innerHTML = '<div class="activity-item text-secondary text-center">Failed to load bookings.</div>';
    }
  }

  (window as any).updateBookingStatus = async (id: string, status: string) => {
    const { data: { session } } = await supabase.auth.getSession();
    const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';
    await fetch(`${apiUrl}/admin/bookings/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session?.access_token}` },
      body: JSON.stringify({ status })
    });
    loadBookings();
  };

  // --- COMMENTS ---
  async function loadComments() {
    const list = document.getElementById('commentsList');
    if (!list) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';

    try {
      const res = await fetch(`${apiUrl}/admin/comments`, {
        headers: { 'Authorization': `Bearer ${session.access_token}` }
      });
      const comments = await res.json();
      
      if(comments.length === 0) {
        list.innerHTML = '<div class="activity-item text-secondary text-center">No comments found.</div>';
        return;
      }
      
      list.innerHTML = comments.map((c: any) => `
        <div class="activity-item" style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong>${c.author_name}</strong> on <em>${c.resource_id}</em>
            <p style="margin-top: 4px;">"${c.content}"</p>
            <p style="margin-top: 4px; font-size: 0.85rem; color: var(--text-secondary);">Status: ${c.is_approved ? 'Approved' : 'Pending'}</p>
          </div>
          <div style="display: flex; gap: 8px;">
            ${!c.is_approved ? `<button class="btn btn-outline" style="font-size: 0.8rem; padding: 4px 8px; border-color: #4ade80; color: #4ade80;" onclick="moderateComment('${c.id}', 'approve')">Approve</button>` : ''}
            <button class="btn btn-outline" style="font-size: 0.8rem; padding: 4px 8px; border-color: #f87171; color: #f87171;" onclick="moderateComment('${c.id}', 'delete')">Delete</button>
          </div>
        </div>
      `).join('');
    } catch(e) {
      list.innerHTML = '<div class="activity-item text-secondary text-center">Failed to load comments.</div>';
    }
  }

  (window as any).moderateComment = async (id: string, action: string) => {
    const { data: { session } } = await supabase.auth.getSession();
    const apiUrl = import.meta.env.PUBLIC_BACKEND_API_URL || 'http://localhost:4000/api';
    if (action === 'approve') {
      await fetch(`${apiUrl}/admin/comments/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session?.access_token}` },
        body: JSON.stringify({ is_approved: true })
      });
    } else if (action === 'delete') {
      if(!confirm("Are you sure you want to delete this comment?")) return;
      await fetch(`${apiUrl}/admin/comments/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${session?.access_token}` }
      });
    }
    loadComments();
  };

  // --- MEDIA LIBRARY ---
  async function loadMedia() {
    const gallery = document.getElementById('mediaGallery');
    if (!gallery) return;
    
    const { data, error } = await supabase.storage.from('uploads').list();
    if (error) {
      gallery.innerHTML = '<div class="text-secondary">Failed to load media.</div>';
      return;
    }
    
    const files = data.filter(f => f.id);
    
    if (files.length === 0) {
      gallery.innerHTML = '<div class="text-secondary" style="grid-column: 1 / -1;">No media found.</div>';
      return;
    }
    
    gallery.innerHTML = files.map(f => {
      const { data: { publicUrl } } = supabase.storage.from('uploads').getPublicUrl(f.name);
      return `
        <div style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background: var(--surface-color);">
          <div style="height: 100px; background-image: url('${publicUrl}'); background-size: cover; background-position: center;"></div>
          <div style="padding: 8px;">
            <p style="font-size: 0.75rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="${f.name}">${f.name}</p>
            <div style="display: flex; justify-content: space-between; margin-top: 8px;">
              <button onclick="navigator.clipboard.writeText('${publicUrl}'); alert('URL Copied!')" class="btn btn-outline" style="font-size: 0.7rem; padding: 2px 4px;">Copy URL</button>
              <button onclick="deleteMedia('${f.name}')" class="btn btn-outline" style="font-size: 0.7rem; padding: 2px 4px; border-color: #f87171; color: #f87171;">Del</button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  (window as any).deleteMedia = async (fileName: string) => {
    if(!confirm("Delete this file?")) return;
    await supabase.storage.from('uploads').remove([fileName]);
    loadMedia();
  };

  const mediaUploadBtn = document.getElementById('mediaUploadBtn');
  if (mediaUploadBtn) {
    mediaUploadBtn.addEventListener('click', async () => {
      const input = document.getElementById('mediaUploadInput') as HTMLInputElement;
      if (!input.files || input.files.length === 0) return alert("Select a file first.");
      
      mediaUploadBtn.textContent = 'Uploading...';
      const file = input.files[0];
      const fileName = `${Date.now()}_${file.name}`;
      
      const { error } = await supabase.storage.from('uploads').upload(fileName, file);
      if (error) alert("Upload failed: " + error.message);
      else {
        input.value = '';
        loadMedia();
      }
      mediaUploadBtn.textContent = 'Upload';
    });
  }

  // --- SETTINGS ---
  const settingsForm = document.getElementById('settingsForm');
  if (settingsForm) {
    settingsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('settingsSubmitBtn');
      if (btn) btn.textContent = 'Updating...';
      
      const newPassword = (document.getElementById('new_password') as HTMLInputElement).value;
      const { error } = await supabase.auth.updateUser({ password: newPassword });
      
      if (error) alert("Failed to update password: " + error.message);
      else {
        alert("Password updated successfully!");
        (settingsForm as HTMLFormElement).reset();
      }
      
      if (btn) btn.textContent = 'Update Password';
    });
  }

  // Run on load
  checkAuth();
</script>
