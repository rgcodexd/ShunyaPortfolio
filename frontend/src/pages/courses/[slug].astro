---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'ue5-environments-masterclass' } },
    { params: { slug: 'hardsurface-concepting' } }
  ];
}

const { slug } = Astro.params;
const courseTitle = slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<Layout title={`${courseTitle} | Shunya Courses`} description={`Enroll in ${courseTitle}.`}>
  <div class="course-detail-page">
    <div class="hero-banner">
      <div class="container hero-content">
        <span class="level">Intermediate to Advanced</span>
        <h1 class="text-display">{courseTitle}</h1>
        <p class="subtitle">A complete workflow from blockout to final cinematic render using Lumen and Nanite.</p>
      </div>
    </div>
    
    <div class="container layout-grid">
      <div class="main-content">
        <section class="overview">
          <h2 class="text-display">Course Overview</h2>
          <p>
            In this masterclass, I take you through my entire environment creation pipeline for Unreal Engine 5. We will cover reference gathering, trim sheet creation, modular modeling, texturing, and finally, lighting and composition inside UE5. 
          </p>
          <p>
            You will receive all project files, including the final UE5 project, Substance Painter files, and Blender source files.
          </p>
        </section>
        
        <section class="curriculum">
          <h2 class="text-display">Curriculum</h2>
          <div class="module">
            <div class="module-header">
              <span class="mod-num">Module 1</span>
              <h3>Planning & Blockout</h3>
            </div>
            <ul class="lesson-list">
              <li>1.1 Understanding Scale in UE5 (15:00)</li>
              <li>1.2 Creating the Blockout in Blender (45:00)</li>
              <li>1.3 Establishing Camera Angles (20:00)</li>
            </ul>
          </div>
          <div class="module">
            <div class="module-header">
              <span class="mod-num">Module 2</span>
              <h3>Trim Sheets & Materials</h3>
            </div>
            <ul class="lesson-list">
              <li>2.1 Designing the Trim Layout (30:00)</li>
              <li>2.2 Sculpting Details in ZBrush (1:10:00)</li>
              <li>2.3 Texturing in Substance Painter (50:00)</li>
            </ul>
          </div>
          <!-- More modules... -->
        </section>
      </div>
      
      <div class="sidebar">
        <div class="enroll-card">
          <div class="video-preview">
            <div class="play-btn">▶</div>
          </div>
          <div class="price-box">
            <span class="price text-display">$149.99</span>
          </div>
          <button class="btn btn-primary w-full enroll-btn">Enroll Now</button>
          
          <ul class="features">
            <li>✓ 12 Hours of Video Content</li>
            <li>✓ All Source Files Included</li>
            <li>✓ Lifetime Access</li>
            <li>✓ Access to Private Discord</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .course-detail-page {
    padding-bottom: var(--spacing-12);
  }
  
  .hero-banner {
    background: linear-gradient(135deg, var(--bg-color), var(--surface-color));
    border-bottom: 1px solid var(--border-color);
    padding: calc(var(--spacing-12) + var(--spacing-8)) 0 var(--spacing-12) 0;
  }
  
  .hero-content {
    max-width: 800px;
  }
  
  .level {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-color);
    font-weight: 700;
    margin-bottom: var(--spacing-2);
    display: block;
  }
  
  .hero-banner h1 {
    font-size: 3.5rem;
    margin-bottom: var(--spacing-4);
  }
  
  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
  }
  
  .layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-8);
    margin-top: var(--spacing-8);
  }
  
  .main-content h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-4);
    color: var(--text-primary);
  }
  
  .overview {
    margin-bottom: var(--spacing-8);
    font-size: 1.1rem;
    line-height: 1.6;
    color: #cccccc;
  }
  
  .overview p {
    margin-bottom: var(--spacing-4);
  }
  
  .module {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-4);
    overflow: hidden;
  }
  
  .module-header {
    background: var(--surface-elevated);
    padding: var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
  }
  
  .mod-num {
    font-size: 0.75rem;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }
  
  .module-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  
  .lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .lesson-list li {
    padding: var(--spacing-3) var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
  }
  
  .lesson-list li:last-child {
    border-bottom: none;
  }
  
  .enroll-card {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--spacing-6);
    position: sticky;
    top: 100px;
  }
  
  .video-preview {
    height: 200px;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-4);
    cursor: pointer;
  }
  
  .play-btn {
    width: 50px;
    height: 50px;
    background: var(--accent-color);
    color: var(--bg-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    padding-left: 5px; /* Visual center for play icon */
  }
  
  .price-box {
    margin-bottom: var(--spacing-4);
    text-align: center;
  }
  
  .price {
    font-size: 3rem;
  }
  
  .w-full {
    width: 100%;
    padding: var(--spacing-3);
    font-size: 1.2rem;
    margin-bottom: var(--spacing-6);
    border: none;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .btn-primary {
    background: var(--accent-color);
    color: var(--bg-color);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .btn-primary:hover {
    background: var(--text-primary);
  }
  
  .features {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .features li {
    margin-bottom: var(--spacing-2);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  
  @media (max-width: 992px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
    
    .enroll-card {
      position: relative;
      top: 0;
      order: -1;
    }
  }
</style>

<script>
  const enrollBtn = document.querySelector('.enroll-btn');
  
  if (enrollBtn) {
    enrollBtn.addEventListener('click', () => {
      alert("Payment integration is coming soon!");
    });
  }
</script>
