---
import logoText from '../assets/logo_text.png';
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="brand text-display" style="display: flex; align-items: center; height: 32px;">
      <img src={logoText.src} alt="Shunya Studio" style="height: 100%; width: auto; object-fit: contain;" />
    </a>
    <nav class="nav">
      <a href="/portfolio">Portfolio</a>
      <a href="/services">Services</a>
      <a href="/courses">Courses</a>
      <a href="/shop">Shop</a>
      <a href="/blog">Blog</a>
      <a href="/booking" class="btn btn-primary">Book a Call</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--spacing-3) 0;
    background: linear-gradient(to bottom, rgba(18, 18, 18, 0.9), transparent);
    backdrop-filter: blur(10px);
  }
  
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .brand {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--text-primary);
  }
  
  .nav {
    display: flex;
    gap: var(--spacing-4);
    align-items: center;
  }
  
  .nav a {
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .btn {
    display: inline-block;
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .btn-primary {
    background-color: var(--accent-color);
    color: var(--bg-color) !important;
  }
  
  .btn-primary:hover {
    background-color: var(--text-primary);
    transform: translateY(-2px);
  }
  
  @media (max-width: 768px) {
    .nav {
      display: none; /* Add mobile menu later */
    }
  }
</style>
